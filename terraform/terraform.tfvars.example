# Copy to terraform.tfvars (gitignored) and fill in real values, or pass
# equivalent -var flags.
#
# Execution/task role ARNs, image, and container port aren't here — they're
# already in ../ecs/task-definition.json; edit that file, not this one, to
# change them.

aws_region = "us-east-1"

hosted_zone_name = "example.com"              # must already exist in Route 53
domain_name      = "books-api.example.com"

# Defaults are usually fine to leave as-is:
# vpc_cidr           = "10.0.0.0/16"
# az_count           = 2
# single_nat_gateway = true
# cluster_name       = "books-api"
# health_check_path  = "/healthz"
# desired_count      = 2
