# Copy to terraform.tfvars (gitignored) and fill in real values, or pass
# equivalent -var flags / a per-environment .tfvars file. Values below follow
# the same EXAMPLE/000000000000 placeholder convention as
# ../ecs/task-definition.json.

aws_region = "us-east-1"

# Platform inputs — from the shared `infrastructure` repo's outputs.
cluster_name            = "books-api"
vpc_id                  = "vpc-EXAMPLE"
subnet_ids              = ["subnet-EXAMPLE1", "subnet-EXAMPLE2"]
security_group_ids      = ["sg-EXAMPLE"]
alb_listener_arn        = "arn:aws:elasticloadbalancing:us-east-1:000000000000:listener/app/shared/EXAMPLE/EXAMPLE"
alb_dns_name            = "shared-EXAMPLE.us-east-1.elb.amazonaws.com"
alb_zone_id             = "Z35SXDOTRQ7X7K" # us-east-1 ALB hosted zone id (constant per region)
hosted_zone_id          = "ZEXAMPLE"
listener_rule_priority  = 10

# Service inputs
# (execution/task role ARNs, image, and container port come from
# ../ecs/task-definition.json — edit that file, not this one, to change them)
domain_name = "books-api.example.com"
