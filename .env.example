# Copy to .env for local runs outside docker compose. Every value here is a
# default from books_api.config — override only what you need.

ENVIRONMENT=local
DEBUG=false

# DynamoDB. Table names default to the real (Terraform-managed) ones — set
# DYNAMODB_ENDPOINT_URL to point at DynamoDB Local / moto instead of real AWS.
AWS_REGION=us-east-1
DYNAMODB_BOOKS_TABLE=books-api-books
DYNAMODB_ISBNS_TABLE=books-api-isbns
DYNAMODB_ENDPOINT_URL=

# OpenTelemetry. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to print metrics to the
# console instead of shipping them to a collector.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=books-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_CONSOLE_EXPORT=false
